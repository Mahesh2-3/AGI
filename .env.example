# Core Reasoning & Planning (Local Qwen 3 8B running on GPU via Ollama)
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=qwen3:4b

# Vision & Screen Perception (Local Qwen 2.5-VL running on GPU via Ollama)
VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VLM_MODEL=qwen2.5vl:3b

# Model Lifecycle & VRAM Optimization (Prevent GPU spikes & Laptop heating)
EXCLUSIVE_MODEL_LOADING=true
OLLAMA_AUTO_UNLOAD_ON_IDLE=true

# Persona Configuration
ASSISTANT_NAME=Jarvis
USER_TITLE=Sir
